# 流萤手机版 APK 打包脚本（Google Colab）
# 使用方法：
# 1. 打开 https://colab.research.google.com/
# 2. 新建笔记本，把这个文件的内容全部复制进去
# 3. 上传 liuying_mobile_package.zip 到 Colab 文件目录
# 4. 依次运行每个单元格
# 5. 打包完成后下载 bin/ 目录下的 APK 文件

# ============================================================
# 单元格1：安装依赖（运行一次，约2-3分钟）
# ============================================================
!apt-get update -qq
!apt-get install -y -qq build-essential git python3-pip python3-dev \
    libncurses5 libncurses5-dev libtinfo5 cmake libffi-dev libssl-dev \
    zip unzip openjdk-17-jdk
!pip3 install --upgrade pip buildozer cython virtualenv
!java -version
!buildozer --version

# ============================================================
# 单元格2：上传并解压项目
# ============================================================
# 先把 liuying_mobile_package.zip 上传到 /content/ 目录
# （点击左侧文件图标，上传文件）

import os
os.chdir('/content')

# 解压项目
!unzip -o liuying_mobile_package.zip -d liuying_mobile
!ls -la liuying_mobile/

# ============================================================
# 单元格3：配置 Android SDK（自动下载，约3-5分钟）
# ============================================================
import os
os.chdir('/content/liuying_mobile')

# 设置环境变量
os.environ['ANDROIDSDK'] = '/content/android-sdk'
os.environ['ANDROIDNDK'] = '/content/android-ndk'
os.environ['ANDROIDAPI'] = '33'
os.environ['NDKAPI'] = '21'

# 下载 Android SDK command line tools
!mkdir -p $ANDROIDSDK/cmdline-tools
!cd /tmp && wget -q https://dl.google.com/android/repository/commandlinetools-linux-9477386_latest.zip -O cmdline-tools.zip
!unzip -q -o /tmp/cmdline-tools.zip -d $ANDROIDSDK/cmdline-tools/
!mv $ANDROIDSDK/cmdline-tools/cmdline-tools $ANDROIDSDK/cmdline-tools/latest

# 安装 SDK 组件
!yes | $ANDROIDSDK/cmdline-tools/latest/bin/sdkmanager --licenses
!$ANDROIDSDK/cmdline-tools/latest/bin/sdkmanager "platform-tools" "platforms;android-33" "build-tools;33.0.2"

# 下载 NDK
!cd /tmp && wget -q https://dl.google.com/android/repository/android-ndk-r25b-linux.zip -O ndk.zip
!unzip -q -o /tmp/ndk.zip -d /content/
!mv /content/android-ndk-r25b $ANDROIDNDK

print("✅ Android SDK 和 NDK 配置完成")

# ============================================================
# 单元格4：开始打包（这一步最久，约15-30分钟）
# ============================================================
import os
os.chdir('/content/liuying_mobile')

# 设置环境变量
os.environ['ANDROIDSDK'] = '/content/android-sdk'
os.environ['ANDROIDNDK'] = '/content/android-ndk'
os.environ['ANDROIDAPI'] = '33'
os.environ['NDKAPI'] = '21'

# 开始打包（debug版本，不需要签名）
!buildozer android debug 2>&1 | tail -50

# ============================================================
# 单元格5：检查并下载 APK
# ============================================================
import os
os.chdir('/content/liuying_mobile')

# 检查生成的APK
!ls -lh bin/*.apk 2>/dev/null || echo "未找到APK，请检查上一步的错误信息"

# 如果有APK，显示下载链接
apk_files = !ls bin/*.apk 2>/dev/null
if apk_files:
    print(f"\n✅ 打包成功！APK文件：{apk_files[0]}")
    print("点击左侧文件图标，进入 bin/ 目录，右键APK文件选择下载")
else:
    print("\n❌ 打包失败，请查看上一步的错误日志")
